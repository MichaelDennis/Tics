{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tics and Boot QEMU",
            "type": "shell",
            "command": "riscv64-unknown-elf-g++",
            "args": [
                "-fno-exceptions",
                "--specs=picolibc.specs",
                "--oslib=semihost",
                "-I./Source",
                "-ggdb3",
                "-march=rv32imac_zicsr",
                "-mabi=ilp32",
                "${file}",
                "-O0",
                "./Source/Tics.cpp",
                "./Source/Target/${config:riscv32TargetPlatform}/Target.cpp",
                "./Source/Target/${config:riscv32TargetPlatform}/Target.s",
                "-o",
                "./Bin/Main.elf",
                "&&",
                "echo",
                "go",
                ">",
                "./Bin/qemu_trigger"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Tics for Linux Host",
            "type": "shell",
            "command": "g++",
            "args": [
                "-m32",
                "-std=c++11",
                "-I./Source",
                "-I/usr/include",
                "-ggdb3",
                "${file}",
                "-O0",
                "./Source/Tics.cpp",
                "./Source/Target/${config:x86TargetPlatform}/Target.cpp",
                "./Source/Target/${config:x86TargetPlatform}/Target.s",
                "-o",
                "./Bin/TicsLinuxTest",
                "-pthread"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}