{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tics x86_32 (Native)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-m32",
                "-std=c++11",
                "-I${workspaceFolder}/Source",
                "-I/usr/include",
                "-ggdb3",
                "-O0",
                "${file}",
                "${workspaceFolder}/Source/Tics.cpp",
                "${workspaceFolder}/Source/Target/x86_32/Target.cpp",
                "${workspaceFolder}/Source/Target/x86_32/Target.s",
                "-o",
                "${workspaceFolder}/Bin/Main"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Tics RISC-V32 (Virt)",
            "type": "shell",
            "command": "riscv64-unknown-elf-g++",
            "args": [
                "-fno-exceptions",
                "--specs=picolibc.specs",
                "--oslib=semihost",
                "-I${workspaceFolder}/Source",
                "-ggdb3",
                "-march=rv32imac_zicsr",
                "-mabi=ilp32",
                "-O0",
                "${file}",
                "${workspaceFolder}/Source/Tics.cpp",
                "${workspaceFolder}/Source/Target/${config:riscv32TargetPlatform}/Target.cpp",
                "${workspaceFolder}/Source/Target/${config:riscv32TargetPlatform}/Target.s",
                "-o",
                "${workspaceFolder}/Bin/Main.elf"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Tics ARM32 MPS2-AN385 (QEMU)",
            "type": "shell",
            "command": "arm-none-eabi-g++",
            "args": [
                "-mcpu=cortex-m3",
                "-mthumb",
                "-O0",
                "--specs=nano.specs",
                "--specs=nosys.specs",
                "-ggdb3",
                "-I${workspaceFolder}/Source",
                "-T${workspaceFolder}/Source/Target/Arm32/mps2_an385.ld",
                "${file}",
                "${workspaceFolder}/Source/Tics.cpp",
                "${workspaceFolder}/Source/Target/Arm32/Target.cpp",
                "${workspaceFolder}/Source/Target/Arm32/Target.s",
                "-o",
                "${workspaceFolder}/Bin/Main.elf"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Tics ARM32 Nucleo-F401RE (Real)",
            "type": "shell",
            "command": "arm-none-eabi-g++",
            "args": [
                "-mcpu=cortex-m4",
                "-mthumb",
                "-mfpu=fpv4-sp-d16",
                "-mfloat-abi=hard",
                "-O0",
                "--specs=nano.specs",
                "--specs=nosys.specs",
                "-ggdb3",
                "-I${workspaceFolder}/Source",
                "-T${workspaceFolder}/Source/Target/Arm32/stm32f401re.ld",
                "${file}",
                "${workspaceFolder}/Source/Tics.cpp",
                "${workspaceFolder}/Source/Target/Arm32/Target.cpp",
                "${workspaceFolder}/Source/Target/Arm32/Target.s",
                "-o",
                "${workspaceFolder}/Bin/Main.elf"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Tics RISC-V32 ESP32-C3 (Real)",
            "type": "shell",
            "command": "riscv32-esp-elf-g++",
            "args": [
                "-march=rv32imc",
                "-mabi=ilp32",
                "-O0",
                "-ggdb3",
                "-I${workspaceFolder}/Source",
                "-T${workspaceFolder}/Source/Target/Riscv32/esp32c3.ld",
                "${file}",
                "${workspaceFolder}/Source/Tics.cpp",
                "${workspaceFolder}/Source/Target/Riscv32/Target.cpp",
                "${workspaceFolder}/Source/Target/Riscv32/Target.s",
                "-o",
                "${workspaceFolder}/Bin/Main.elf"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "start-qemu-riscv32",
            "type": "shell",
            "command": "${workspaceFolder}/Scripts/launch_qemu.sh riscv32",
            "problemMatcher": [],
            "dependsOn": "Build Tics RISC-V32 (Virt)"
        },
        {
            "label": "start-qemu-arm32",
            "type": "shell",
            "command": "${workspaceFolder}/Scripts/launch_qemu.sh arm32",
            "problemMatcher": [],
            "dependsOn": "Build Tics ARM32 MPS2-AN385 (QEMU)"
        },
        {
            "label": "start-stlink-gdbserver-f401re",
            "type": "shell",
            "command": "openocd -f interface/stlink.cfg -f target/stm32f4x.cfg",
            "isBackground": false,
            "problemMatcher": [],
            "dependsOn": "Build Tics ARM32 Nucleo-F401RE (Real)",
            "presentation": {
                "reveal": "never"
            }
        },
        {
            "label": "start-esp-usb-jtag-gdbserver-c3",
            "type": "shell",
            "command": "openocd -f interface/esp_usb_jtag.cfg -f target/esp32c3.cfg",
            "isBackground": false,
            "problemMatcher": [],
            "dependsOn": "Build Tics RISC-V32 ESP32-C3 (Real)",
            "presentation": {
                "reveal": "never"
            }
        }
    ]
}