{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tics 32-Bit",
            "type": "shell",
            "command": "riscv64-unknown-elf-g++",
            "args": [
                "-fno-exceptions",
                "--specs=picolibc.specs",
                "--oslib=semihost",
                "-I./Source",
                "-ggdb3",
                "-march=rv32imac",
                "-mabi=ilp32",
                "./Source/Target/Riscv32/Main.cpp",
                "-O0",
                "./Source/Tics.cpp",
                "./Source/Target/Riscv32/Target.cpp",
                "./Source/Target/Riscv32/Target.s",
                "-o",
                "./Bin/Main.elf"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
