{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tics and Boot QEMU",
            "type": "shell",
            "command": "riscv64-unknown-elf-g++",
            "args": [
                "-fno-exceptions",
                "--specs=picolibc.specs",
                "--oslib=semihost",
                "-I./Source",
                "-ggdb3",
                "-march=rv32imac",
                "-mabi=ilp32",
                "${file}",
                "-O0",
                "./Source/Tics.cpp",
                "./Source/Target/${config:tics.targetPlatform}/Target.cpp",
                "./Source/Target/${config:tics.targetPlatform}/Target.s",
                "-o",
                "./Bin/Main.elf",
                "&&", "echo", "go", ">", "./Bin/qemu_trigger"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
