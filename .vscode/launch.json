{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Connect GDB to QEMU",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/Main.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "Build Tics and Boot QEMU"
        },
        {
            "name": "Debug Tics on Linux Host (x86_32)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/TicsLinuxTest",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "Build Tics for Linux Host",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}