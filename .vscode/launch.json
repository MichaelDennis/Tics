{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Tics RISC-V32 (Virt)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/Main.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "Build Tics RISC-V32 (Virt)"
        },
        {
            "name": "Debug Tics ARM32 (MPS2-AN385)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/Main.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "Build Tics ARM32 (MPS2-AN385)",
            "setupCommands": [
                {
                    "text": "set architecture arm",
                    "ignoreFailures": false
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Tics x86_32 (Native)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/TicsLinuxTest",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "Build Tics x86_32 (Native)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Sandbox ARM Baseline",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Sandbox/ArmTest/ArmTest.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "cwd": "${workspaceFolder}/Sandbox/ArmTest",
            "stopAtEntry": true
        }
    ]
}