{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Connect GDB to QEMU",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/Main.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "Build Tics and Boot QEMU"
        },
        {
            "name": "Connect ARM GDB to QEMU",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/Main.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "Build Tics for ARM and Boot QEMU",
            "setupCommands": [
                {
                    "text": "set architecture arm",
                    "ignoreFailures": false
                },
                {
                    "text": "target remote 127.0.0.1:1234",
                    "ignoreFailures": false
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Tics on Linux Host (x86_32)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/TicsLinuxTest",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "Build Tics for Linux Host",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug Sandbox ARM Baseline",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Sandbox/ArmTest/ArmTest.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "cwd": "${workspaceFolder}/Sandbox/ArmTest",
            "stopAtEntry": true
        },
        {
            "name": "Debug Arm32 ARM Baseline",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Source/Target/Arm32/ArmTest.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "cwd": "${workspaceFolder}/Source/Target/Arm32",
            "stopAtEntry": true
        },
        {
            "name": "Debug Tics ArmSimulated",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Sandbox/ArmTest/ArmSimulated/ArmTest.elf",
            "MIMode": "gdb",
            "targetArchitecture": "arm",
            "miDebuggerPath": "gdb-multiarch",
            "cwd": "${workspaceFolder}/Sandbox/ArmTest/ArmSimulated",
            "stopAtEntry": true,
            "customLaunchSetupCommands": [
                {
                    "text": "set architecture arm",
                    "ignoreFailures": false
                },
                {
                    "text": "target remote | qemu-arm -g 1234 -semihosting ${workspaceFolder}/Sandbox/ArmTest/ArmSimulated/ArmTest.elf",
                    "ignoreFailures": false
                }
            ],
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}