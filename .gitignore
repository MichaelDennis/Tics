# --- Build Artifacts (The "Noise") ---

# Ignore the Sandbox folder
Sandbox/

# Ignore the entire bin folder completely
Bin/

# --- IDE Configuration (The "Signal") ---
# 1. Ignore EVERYTHING inside .vscode by default
.vscode/*

# 2. Specifically ALLOW (Whitelist) these critical logic files
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json
!.vscode/settings.json

# 3. Allow the workspace manager file
!Tics.code-workspace

# --- System Garbage ---
.DS_Store
Thumbs.db
desktop.ini

# Ignore all compiled executables and binaries
*.elf
*.bin
*.hex
*.out

# Ignore all intermediate object files and dependency listings
*.o
*.obj
*.d

# Ignore all target map files generated by the linker
*.map
